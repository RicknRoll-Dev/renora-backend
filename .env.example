# Copy to .env for local development: cp .env.example .env
APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=text

HTTP_ADDR=:8080
ADMIN_ADDR=:9090
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

DATABASE_URL=postgres://renora:renora@localhost:55432/renora?sslmode=disable
REDIS_URL=redis://localhost:56379/0

# Sign-in. AUTH_SECRET keys the stored code hashes: at least 32 bytes, required
# outside development (make one with: openssl rand -base64 48). Left empty in
# development, each run makes its own, so codes do not survive a restart.
AUTH_SECRET=
# "log" writes sign-in codes to the API log instead of sending them; refused in production.
AUTH_CODE_SENDER=log
# Browsers treat http://localhost as secure, so Secure cookies work locally.
SESSION_COOKIE_SECURE=true
# Set (e.g. renora.id) only when the web app and the API are on different subdomains.
SESSION_COOKIE_DOMAIN=

GRAPHQL_COMPLEXITY_LIMIT=1000
GRAPHQL_DEPTH_LIMIT=12

# Leave empty to keep tracing off locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
